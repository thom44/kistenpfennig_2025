

  <div class="random-product">

    <div class="random-product-image">
      {{ fields.field_product_image.content }}

      <div class="random-product-overlay">
        <div class="random-product-title">
          {{ fields.title.content }}
        </div>

      </div>
    </div>

    <div class="random-product-info">

      <div class="random-product-price">
        {{ fields.price__number.content }}
      </div>

      <div class="btn-wrap">
        <button type="button" class="product-details-button">
          Details
        </button>
      </div>

    </div>

  </div>
