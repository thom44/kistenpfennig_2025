{#
/**
 * @file
 *
 * Default product template.
 *
 * Available variables:
 * - attributes: HTML attributes for the wrapper.
 * - product: The rendered product fields.
 *   Use 'product' to print them all, or print a subset such as
 *   'product.title'. Use the following code to exclude the
 *   printing of a given field:
 *   @code
 *   {{ product|without('title') }}
 *   @endcode
 * - product_entity: The product entity.
 * - product_url: The product URL.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @ingroup themeable
 */
#}
<article{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {# {{- product|without('variation_attributes') -}} #}
  <div class="product-wrapper">
  <div class="container">
  <div class="row">
    <div class="col-lg-3 col-md-12"><p><span class="medium red">{{ product_entity.title.value }}</span><br /><span class="medium red itlc">Lebkuchen</span></p>
    {{ product.body }}
    <div class="accordion" id="accordionExample">
    
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
          Nährstoffe
        </button>
      </h2>
      <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
        <div class="accordion-body">
          {{ product.field_header }} {{ product.field_nutritive_value }}
        </div>
      </div>
    </div>
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
          Inhaltsstoffe
        </button>
      </h2>
      <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
        <div class="accordion-body">
          {{ product.field_ingredient }} {{ product.field_allergene }}
        </div>
      </div>
    </div>
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
          Haltbarkeit
        </button>
      </h2>
      <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
        <div class="accordion-body">
          <p>Für den vollen Genuß empfehlen wir Ihnen einen baldigen Verzehr.<br />Evtl. Lagerung bitte trocken, kühl und dunkel bis zu 4 Wochen, da wir natürlich auf Konservierungsstoffe verzichten.</p>
        </div>
      </div>
    </div>
  </div>

    </div>
    <div class="col-lg-6 col-md-12">{{ product.field_product_image }}</div>

    <div class="col-lg-3 col-md-12">
      <div>{{ product|without('field_product_image','field_nutritive_value','body','field_ingredient','field_allergene','field_header') }}</div>




  </div><!-- /.row -->
  </div>
  </div><!-- /.product-wrapper -->


</article>
